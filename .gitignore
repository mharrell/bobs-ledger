# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE
.idea/

# Claude Code worktrees (isolated checkouts)
.claude/worktrees/

# Stop-hook ack latches (per-session, wt_stop_check.sh)
.claude/wt-status/

# Vendored dependency — has its own .git (decide: vendor / submodule / keep ignored)
hearth-coach/python-hslog/

# Scraper cache — downloaded hearthstonejson card list, regenerable
hearth-coach/.cards_cache.json
hearth-coach/.cards_full.json
hearth-coach/.card_races.json
# refresh_trinkets downloads — hsjson cards + hsreplay guides, regenerable
hearth-coach/meta/.trinkets_hsjson_cache.json
hearth-coach/meta/.trinkets_guides_cache.json
# Observed CARDRACE per card id from local Power.logs (parse_minions
# --refresh-tribes), regenerable and machine-specific (local log paths)
hearth-coach/.observed_tribes.json

# On-demand art fetch failures (coach_ui), regenerable
hearth-coach/.art_miss.json

# Per-user advisory telemetry (the beta corpus pairs these with Power.logs)
hearth-coach/decision_logs/

# Packaged corpus bundles awaiting upload
hearth-coach/corpus_out/

# Generated patch-check artifacts (review reports + last-seen state)
hearth-coach/patch_reports/
hearth-coach/meta/.patch_state.json
hearth-coach/meta/.patch_config.json
hearth-coach/logs_archive/

# Automation caches (logquery/review_kit): regenerable, machine-specific
hearth-coach/.review_cache/

# comp_miner proposals: derived from the local log corpus (which is not in the
# repo), regenerable, and never a source of truth — promotion is a human edit
# to meta/comps.json
hearth-coach/meta/comp_candidates.json

# corpus bundles never leave the machine un-asked
corpus_out/
VERSION

# Wrangler local state — carries the CF account id / account email
.wrangler/
telemetry/.wrangler/
.dev.vars
*.env

# Local API-key bootstrap helper (never ships, never commits)
claude_code_zai_env.sh

# YouTube auto-transcripts (third-party caption text, takedown bait):
# derived research cache — mined into the guides, never republished.
# Both spellings: the directory actually lives under meta/, and the original
# rule named a path that never existed — leaving the caption text untracked
# but NOT ignored, one `git add -A` from being committed.
hearth-coach/transcripts/
hearth-coach/meta/transcripts/

# Per-install update state (the version + publish time this install
# carries). Written by update.py; publish_release.py stamps a fresh one into
# every release zip, so a stale local copy must not be committed or shipped.
.update_state.json

# Scratch dirs used while verifying a release build
.tmp_*/

# Shortcuts: created by the launcher on the machine that uses them, and they
# embed absolute paths — never committed, never shipped (publish_release.py
# excludes *.lnk as well, since it walks the working tree rather than git).
*.lnk

