# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE
.idea/

# Claude Code worktrees (isolated checkouts)
.claude/worktrees/

# Stop-hook ack latches (per-session, wt_stop_check.sh)
.claude/wt-status/

# NOTE: python-hslog/ is TRACKED. It used to be gitignored, which meant a
# clone lacked the parser while the release zip had it — the spin-out into
# this repo made the repo and the release the same tree, so it is vendored
# properly now (upstream's own tests, which carry third-party BattleTags,
# are not vendored).

# Regenerable caches — downloaded card data, rebuilt by the tools here
# (parse_minions.py --refresh-tribes, scrape_comps.py, patch_day.py)
.cards_cache.json
.cards_full.json
.observed_tribes.json
meta/.trinkets_hsjson_cache.json
meta/.trinkets_guides_cache.json

# On-demand art fetch failures (coach_ui), regenerable
.art_miss.json

# Per-user advisory telemetry (the beta corpus pairs these with Power.logs)
decision_logs/

# The user's sharing answer, and the distilled reports this install has sent
# (session_reports/ holds a local copy of everything shared plus the per-session
# id map). Local state, never a source of truth, and the one kind of file this
# project must never commit by accident: `git add -A` took the id map as
# untracked before this line existed (2026-10-03).
.share_consent.json
session_reports/

# Packaged corpus bundles awaiting upload
corpus_out/

# Local Power.log archives and generated patch-check artifacts
logs_archive/
patch_reports/
meta/.patch_state.json
meta/.patch_config.json

# Automation caches (logquery/review_kit): regenerable, machine-specific
.review_cache/

# comp_miner proposals: derived from the local log corpus (which is not in the
# repo), regenerable, and never a source of truth — promotion is a human edit
# to meta/comps.json
meta/comp_candidates.json

# YouTube auto-transcripts (third-party caption text, takedown bait):
# derived research cache — mined into the guides, never republished.
transcripts/
meta/transcripts/

# The card->tribe map is downloaded from HearthstoneJSON, but it SHIPS inside
# every release so a first run needs no network (bans._load_card_races reads
# it before it would ever fetch). Gitignored because it is regenerable;
# publish_release.py lists it in UNTRACKED_OK so it still ships.
.card_races.json

# A built release zip is an artifact, not a source file
bobs-ledger-*.zip

# Per-install stamps: VERSION is written by publish_release.py into each zip,
# .update_state.json by update.py on apply. A stale local copy must not be
# committed or shipped.
VERSION
.update_state.json

# Wrangler local state — carries the CF account id / account email
.wrangler/
telemetry/.wrangler/
.dev.vars
*.env

# Local API-key bootstrap helper (never ships, never commits)
claude_code_zai_env.sh

# Scratch dirs used while verifying a release build
.tmp_*/

# Shortcuts: created by the launcher on the machine that uses them, and they
# embed absolute paths — never committed, never shipped (publish_release.py
# excludes *.lnk too, since it walks the working tree rather than git).
*.lnk
